# /etc/men-tarmoq/agent.env  (chmod 600)
# Faqat WireGuard IP sida tinglash — internetdan ko'rinmaydi
AGENT_BIND=10.99.0.2
# VPS dagi LAB_AGENT_TOKEN bilan bir xil bo'lishi shart:  openssl rand -hex 32
AGENT_TOKEN=CHANGE_ME
LABS_DIR=/opt/men-tarmoq/labs
WORK_DIR=/var/lib/men-tarmoq/labs
MAX_LABS=8
MAX_TTL_MINUTES=240
NODE_MEMORY=512MB
NODE_CPU=1
MGMT_POOL=172.31.0.0/16
TERM_IMAGE=men-tarmoq/term:latest
TERM_NETWORK=labterm
TERM_BASE_PATH=/term
