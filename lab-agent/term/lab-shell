#!/bin/bash
# Men Tarmoq lab terminali: talaba faqat o'z lab tugunlariga ulana oladi.
# Foydalanish: lab-shell <clab-nomi> <tugun>:<shell> [<tugun>:<shell> ...]
set -u
LAB="$1"; shift
NODES=(); SHELLS=()
for spec in "$@"; do NODES+=("${spec%%:*}"); SHELLS+=("${spec#*:}"); done

connect() {
  local idx=$1 shell=$2 name="${NODES[$1]}"
  printf '\n\033[1;36m→ %s ga ulanilmoqda (%s). Menyuga qaytish: exit yoki Ctrl-D\033[0m\n\n' "$name" "$shell"
  docker exec -it -e TERM=xterm-256color "clab-${LAB}-${name}" "$shell" \
    || docker exec -it "clab-${LAB}-${name}" sh
}

trap '' INT
while true; do
  printf '\033[2J\033[H'
  printf '\033[1;34m╔══════════════════════════════════════╗\n'
  printf '║        Men Tarmoq · Lab terminal      ║\n'
  printf '╚══════════════════════════════════════╝\033[0m\n\n'
  for i in "${!NODES[@]}"; do
    printf '  \033[1m%2d)\033[0m %-12s \033[2m(%s)\033[0m\n' "$((i + 1))" "${NODES[$i]}" "${SHELLS[$i]}"
  done
  printf '\n  Raqam — asosiy shell, raqam+s (masalan 1s) — Linux shell (sh)\n\n'
  read -r -p "Tugunni tanlang: " choice || exit 0
  linux=0
  if [[ "$choice" =~ ^([0-9]+)s$ ]]; then linux=1; choice="${BASH_REMATCH[1]}"; fi
  if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#NODES[@]} )); then
    idx=$((choice - 1))
    if (( linux )); then connect "$idx" sh; else connect "$idx" "${SHELLS[$idx]}"; fi
  fi
done
