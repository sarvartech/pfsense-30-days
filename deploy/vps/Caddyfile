{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Lab terminallari: faqat lab egasi (web platforma tekshiradi) → WireGuard → home Traefik → ttyd
	handle /term/* {
		forward_auth web:8000 {
			uri /internal/term-auth
			# WebSocket upgrade sarlavhalari auth so'roviga uzatilmaydi
			header_up -Upgrade
			header_up -Connection
		}
		reverse_proxy {$HOME_WG_IP}:8088 {
			transport http {
				dial_timeout 5s
			}
		}
	}

	# Ichki endpointlar tashqaridan yopiq
	handle /internal/* {
		respond 404
	}

	handle {
		reverse_proxy web:8000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}
}
