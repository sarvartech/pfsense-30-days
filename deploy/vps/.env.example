# ---- deploy/vps/.env  (git ga qo'shilmaydi!) ----
DOMAIN=tarmoq.example.uz
ACME_EMAIL=admin@example.uz

# --- Rejim (preflight-vps.sh tavsiyasiga qarab bittasini qoldiring) ---
# A) 80/443 bo'sh — Caddy o'zi HTTPS qiladi:
COMPOSE_FILE=docker-compose.yml:ports.caddy.yml
# B) 80/443 ni boshqa proxy egallagan — faqat 127.0.0.1:8010, TLS ni mavjud proxy qiladi:
# COMPOSE_FILE=docker-compose.yml:ports.proxy.yml
# SITE_ADDRESS=:80
# PROXY_PORT=8010
# Mavjud proxy Docker konteynerda bo'lsa (masalan Nginx Proxy Manager): PROXY_BIND=172.17.0.1
# PROXY_BIND=127.0.0.1

SITE_NAME=Men Tarmoq
# openssl rand -hex 32
SECRET_KEY=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
# Shu emaillar bilan ro'yxatdan o'tganlar admin bo'ladi (vergul bilan)
ADMIN_EMAILS=admin@example.uz
ALLOW_REGISTRATION=true

# Home server (WireGuard orqali)
HOME_WG_IP=10.99.0.2
LAB_AGENT_URL=http://10.99.0.2:8090
# Home serverdagi /etc/men-tarmoq/agent.env dagi AGENT_TOKEN bilan bir xil
LAB_AGENT_TOKEN=CHANGE_ME
LAB_TTL_MINUTES=90
MAX_LABS_PER_USER=1
