# ---- deploy/vps/.env  (git ga qo'shilmaydi!) ----
DOMAIN=tarmoq.example.uz
ACME_EMAIL=admin@example.uz

SITE_NAME=Men Tarmoq
# openssl rand -hex 32
SECRET_KEY=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
# Shu emaillar bilan ro'yxatdan o'tganlar admin bo'ladi (vergul bilan)
ADMIN_EMAILS=admin@example.uz
ALLOW_REGISTRATION=true

# Home server (WireGuard orqali)
HOME_WG_IP=10.99.0.2
LAB_AGENT_URL=http://10.99.0.2:8090
# Home serverdagi /etc/men-tarmoq/agent.env dagi AGENT_TOKEN bilan bir xil
LAB_AGENT_TOKEN=CHANGE_ME
LAB_TTL_MINUTES=90
MAX_LABS_PER_USER=1
